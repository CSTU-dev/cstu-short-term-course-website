# Copy to `.env` and fill in. Validated at startup by lib/env.ts.

NODE_ENV=development

# PostgreSQL connection string (required).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cstu_dev?schema=public"

# Auth.js (required). Generate with: openssl rand -base64 33  (or: npx auth secret)
AUTH_SECRET=""
# Canonical site URL Auth.js uses for callbacks (e.g. https://your-domain).
AUTH_URL="http://localhost:3000"

# Google SSO (optional until configured). Authorized redirect URI:
#   {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cold-start superAdmin, consumed by `prisma db seed` (idempotent upsert).
SUPERADMIN_EMAIL="superadmin@cstu.edu"
SUPERADMIN_PASSWORD="set-a-strong-password"

# Outbound email for admin invites (optional in dev). Any nodemailer URL.
SMTP_URL=""
EMAIL_FROM="CSTU <no-reply@cstu.edu>"

# Public base URL used to construct referral links / QR codes.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe. Get keys from the Stripe Dashboard (Developers > API keys). Use the
# test-mode keys (pk_test_… / sk_test_…) in development.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Signing secret (whsec_…) for the /webhook/stripe endpoint. Locally this is
# printed by `stripe listen --forward-to localhost:3000/webhook/stripe`; when
# deployed it comes from the Dashboard webhook endpoint's signing secret.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Set to 1 to skip env validation (e.g. during CI builds without secrets).
# SKIP_ENV_VALIDATION=1
