# Copy to `.env` and fill in. Validated at startup by lib/env.ts.

NODE_ENV=development

# PostgreSQL connection string (required).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cstu_dev?schema=public"

# Auth.js (required). Generate with: openssl rand -base64 33  (or: npx auth secret)
AUTH_SECRET=""
# Canonical site URL Auth.js uses for callbacks (e.g. https://your-domain).
AUTH_URL="http://localhost:3000"

# Google SSO (optional until configured). Authorized redirect URI:
#   {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cold-start superAdmin, consumed by `prisma db seed` (idempotent upsert).
SUPERADMIN_EMAIL="superadmin@cstu.edu"
SUPERADMIN_PASSWORD="set-a-strong-password"

# Outbound email for admin invites. Any nodemailer URL.
#   DEV      leave empty (invite link is logged) OR point at local Mailpit:
#            SMTP_URL="smtp://localhost:1025"   (docker compose up -d mailpit,
#            read captured mail at http://localhost:8025)
#   STAGING  real Gmail (Google Workspace) + EMAIL_ALLOWLIST below, so only
#            testers get mail. cstu.edu is on Google Workspace, so the host is
#            smtp.gmail.com and the password is a Google App Password (2FA on,
#            16 chars, spaces removed, '@' encoded as %40):
#            SMTP_URL="smtp://user%40cstu.edu:APP_PASSWORD@smtp.gmail.com:587"
#   PROD     same real Gmail URL, from a secret store; leave EMAIL_ALLOWLIST unset.
SMTP_URL=""
EMAIL_FROM="CSTU <no-reply@cstu.edu>"
# Recipient allowlist (comma-separated). A whole domain ("@cstu.edu" or
# "cstu.edu") or a single address ("alice@partner.com"). When set, only matching
# recipients receive real mail — everyone else is dropped and logged. On STAGING
# set this to the cstu.edu domain so any @cstu.edu tester gets invites; leave
# UNSET in production so all real users get their mail.
EMAIL_ALLOWLIST="@cstu.edu"

# Public base URL used to construct referral links / QR codes.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe. Get keys from the Stripe Dashboard (Developers > API keys). Use the
# test-mode keys (pk_test_… / sk_test_…) in development.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Signing secret (whsec_…) for the /webhook/stripe endpoint. Locally this is
# printed by `stripe listen --forward-to localhost:3000/webhook/stripe`; when
# deployed it comes from the Dashboard webhook endpoint's signing secret.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Set to 1 to skip env validation (e.g. during CI builds without secrets).
# SKIP_ENV_VALIDATION=1
